{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "i18n/**/*.ts",
    "shared/**/*.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
