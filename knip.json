{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}"],
  "project": ["app/**/*.{ts,tsx}", "domains/**/*.{ts,tsx}", "shared/**/*.{ts,tsx}", "i18n/**/*.ts"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignore": ["shared/ui/theme-switcher.tsx"]
}
